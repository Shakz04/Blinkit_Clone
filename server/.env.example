PORT=5000
MONGODB_URI=mongodb://localhost:27017/blinkit
JWT_SECRET=your_jwt_secret_change_in_production

# Optional identity and initial password for the built-in FreshDash seller.
# If the password is omitted, the setup command prints a generated temporary password.
FRESHDASH_SELLER_EMAIL=freshdash.operations@local.invalid
FRESHDASH_SELLER_PASSWORD=choose_a_strong_private_password

# Razorpay (get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
